Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generaci\[OAcute]n", " ", "de", " ", "datos", " ", "exactos", " ", "en", " ",
     "el", " ", "r\[EAcute]gimen", " ", "de", " ", "perturbaci\[OAcute]n", " ",
     "peque\[NTilde]a"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datosCorriente", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"DT", ",", 
         RowBox[{"Jhibrido", "[", 
          RowBox[{"Tbase", ",", "DT"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"DT", ",", "0.001", ",", "0.2", ",", "0.005"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Ajuste", " ", "polinomial", " ", "de", " ", "la", " ", "corriente", " ",
       "J"}], "=", 
     RowBox[{
      RowBox[{"c1", "*", "DT"}], "+", 
      RowBox[{"c2", "*", 
       RowBox[{"DT", "^", "2"}]}], "+", 
      RowBox[{"c3", "*", 
       RowBox[{"DT", "^", "3"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ajuste", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"datosCorriente", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"x", "^", "2"}], ",", 
         RowBox[{"x", "^", "3"}]}], "}"}], ",", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Extracci\[OAcute]n", " ", "de", " ", "coeficientes", " ", 
     "num\[EAcute]ricos"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coefsNumericos", "=", 
     RowBox[{"ajuste", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Comparaci\[OAcute]n", " ", "con", " ", "nuestros", " ", "hallazgos", " ",
      "anal\[IAcute]ticos"}], "*)"}], "\[IndentingNewLine]", 

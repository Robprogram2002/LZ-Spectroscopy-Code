           RowBox[{"Csch", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
       ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Sistema", " ", "H\[IAcute]brido"}], ",", 

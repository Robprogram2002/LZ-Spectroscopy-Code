Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Fijamos", " ", "la", " ", "Temperatura", " ", "Media", " ", "de", " ", 
    "los", " ", "ba\[NTilde]os"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Tm", " ", "=", " ", "5.0"}], ";"}], " ", "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Parametrizaci\[OAcute]n", " ", "de", " ", "TL", " ", "y", " ", "TR", " ",
      "en", " ", "funci\[OAcute]n", " ", "del", " ", "gradiente", " ", "DT"}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"TL", "[", "DT_", "]"}], " ", ":=", " ", 
     RowBox[{"Tm", " ", "+", " ", 
      RowBox[{"DT", "/", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"TR", "[", "DT_", "]"}], " ", ":=", " ", 
     RowBox[{"Tm", " ", "-", " ", 
      RowBox[{"DT", "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "CONDUCTANCIA", " ", "SIM\[CapitalEAcute]TRICA", " ", 
     RowBox[{"(", 
      RowBox[{"L\[CapitalIAcute]NEA", " ", "BASE", " ", "CONSTANTE"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K0Constante", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Pi", "^", "2"}], ")"}], "/", 
       RowBox[{"(", "3", ")"}]}], "*", "Tm"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Khibrido2", "[", "DT_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"DT", "==", "0"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"7", "*", 
          RowBox[{
           RowBox[{"Zeta", "[", "3", "]"}], "/", "4"}]}], ")"}], "*", "Tm"}], 
       ",", 
       RowBox[{
        RowBox[{"Jhibrido", "[", 
         RowBox[{
          RowBox[{"TL", "[", "DT", "]"}], ",", 
          RowBox[{"TR", "[", "DT", "]"}]}], "]"}], "/", "DT"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "El", " ", "dominio", " ", "l\[OAcute]gico", " ", "de", " ", "DT", " ", 
     "va", " ", "desde", " ", "0", " ", "hasta", " ", "2", "*", "Tm", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"cuando", " ", "TR"}], "=", "0"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Cortamos", " ", "ligeramente", " ", "antes", " ", "de", " ", "2", "*", 
      "Tm", " ", "para", " ", "evitar", " ", "singularidad", " ", "en", " ", 
      "TR"}], "=", "0"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 

 RowBox[{
  RowBox[{"datosNorm2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{
        RowBox[{"KBF", "[", "r", "]"}], "/", 
        RowBox[{"KSmall", "[", "r", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rValues"}], "}"}]}], "]"}]}], ";"}]], "Input",

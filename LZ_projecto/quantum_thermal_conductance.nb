Cell[TextData[{
 "Vamos a reescribir las expresiones para cada conductancia usando la \
variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    FractionBox["hv", 
     RowBox[{
      SubscriptBox["k", "B"], "T"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa9d54e7-afb7-4f43-ac41-de04ea9fb236"],
 " de manera que  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["k", "B"], "T"}], "h"], "x"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0afe2bf-1909-4806-a48d-15ce9b205dcd"],
 ". De esta forma desaparecen todas las dimensiones y la comparaci\[OAcute]n \
es mucho m\[AAcute]s limpia ya que las expresiones ahora se escriben \
(igualando las constantes uuniversales y la temperatura T a 1) como:"
}], "Text",
 CellChangeTimes->{{3.9951149954387703`*^9, 3.9951151277986603`*^9}, 
   3.9951151793731823`*^9, {3.995115878051619*^9, 
   3.995115917683919*^9}},ExpressionUUID->"c0ab1d2f-f2eb-44dd-818b-\
ccca0782e671"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sistema", " ", "completamente", " ", "Bos\[OAcute]nico", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"KappaBoson", "[", 
      RowBox[{"gL_", ",", "gR_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "*", 
          RowBox[{"gR", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "+", 
          RowBox[{"gR", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "*", 
          RowBox[{
           RowBox[{"Csch", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Sistema", " ", "completamente", " ", "Fermi\[OAcute]nico", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KappaFermion", "[", 
      RowBox[{"gL_", ",", "gR_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "*", 
          RowBox[{"gR", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "+", 
          RowBox[{"gR", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "*", 
          RowBox[{
           RowBox[{"Sech", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
       ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Sistema", " ", "H\[IAcute]brido"}], ",", 
     RowBox[{"Central", " ", "Bos\[OAcute]nico", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"+", "1"}], ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"-", "1"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KappaHibridoB", "[", 
      RowBox[{"gL_", ",", "gR_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "*", 
          RowBox[{"gR", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"gL", "^", "2"}], "*", 
           RowBox[{"Coth", "[", 
            RowBox[{"x", "/", "2"}], "]"}]}], "+", 
          RowBox[{"gR", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "*", 
          RowBox[{
           RowBox[{"Csch", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Sistema", " ", "H\[IAcute]brido"}], ",", 
     RowBox[{"Central", " ", "Fermi\[OAcute]nico", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"+", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KappaHibridoF", "[", 
      RowBox[{"gL_", ",", "gR_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "*", 
          RowBox[{"gR", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gL", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"Tanh", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "*", 
           RowBox[{"gR", "^", "2"}]}]}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "*", 
          RowBox[{
           RowBox[{"Sech", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
       ")"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9951151622458553`*^9, 3.995115272621791*^9}, {
  3.995115305155963*^9, 3.995115553527234*^9}, {3.995115809354836*^9, 
  3.995115811710538*^9}, {3.995128577069888*^9, 
  3.9951285857571583`*^9}},ExpressionUUID->"6b054cd7-231a-41ba-9df6-\
6575e6455b25"],


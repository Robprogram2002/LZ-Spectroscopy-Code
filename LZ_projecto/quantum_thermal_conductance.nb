Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KappaHibridoF", "[", 
    RowBox[{"r_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", "*", 
         RowBox[{"Tanh", "[", 
          RowBox[{"x", "/", "2"}], "]"}]}], "+", "1"}], ")"}]}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "*", 
        RowBox[{
         RowBox[{"Sech", "[", 
          RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
     ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9951284663287907`*^9, 3.995128469854624*^9}, {
  3.995128616800518*^9, 3.995128619887879*^9}},

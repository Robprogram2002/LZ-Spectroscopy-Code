Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generamos", " ", "los", " ", "datos", " ", "en", " ", "paralelo"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"datosEta", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"TR", ",", "TL", ",", 
         RowBox[{"Jdiff", "[", 
          RowBox[{"TL", ",", "TR"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"TL", ",", "Tmin", ",", "Tmax", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Tmax", "-", "Tmin"}], ")"}], "/", "resolucion"}]}], "}"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"TR", ",", "Tmin", ",", "Tmax", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Tmax", "-", "Tmin"}], ")"}], "/", "resolucion"}]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Aplanamos", " ", "la", " ", "estructura", " ", "tensorial", " ", "a", " ",
      "una", " ", "simple", " ", "lista", " ", "de", " ", "coordenadas", " ", 
     
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"datosPlanos", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"datosEta", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Construimos", " ", "el", " ", "mapa", " ", "de", " ", "densidad"}], 
    "*)"}], "\n", 
   RowBox[{"mapaDensidad", "=", 
    RowBox[{"ListDensityPlot", "[", 
     RowBox[{"datosPlanos", ",", 
      RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"BarLegend", "[", 
        RowBox[{"Automatic", ",", "\[IndentingNewLine]", 
         RowBox[{"LegendLabel", "->", "\"\<J_diff\>\""}]}], "]"}]}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Temperatura Ba\[NTilde]o Derecho \
\\!\\(\\*SubscriptBox[\\(T\\), \\(R\\)]\\) (Fermiones)\>\"", ",", 
         "\[IndentingNewLine]", "\"\<Temperatura Ba\[NTilde]o Izquierdo \
\\!\\(\\*SubscriptBox[\\(T\\), \\(L\\)]\\) (Bosones)\>\""}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotLabel", "->", "\"\<Valor de J_diff\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"BoundaryStyle", "->", "None"}], ",", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{"FontSize", "->", "14"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "A\[NTilde]adimos", " ", "la", " ", "l\[IAcute]nea", " ", "diagonal", " ",
         "punteada", " ", "que", " ", "representa", " ", "el", " ", 
        "equilibrio", " ", "termodin\[AAcute]mico"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "White", ",", "Thick", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Tmin", ",", "Tmin"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Tmax", ",", "Tmax"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
      ",", " ", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",

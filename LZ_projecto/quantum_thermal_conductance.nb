Cell[TextData[{
 "Para la sigiente gr\[AAcute]fica vamos a normalizar el valor de KBF con \
respecto al limite bos\[OAcute]nico K_BB = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Pi]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ddaaaf92-efa0-494d-9feb-66f006822541"],
 "/3. Como KBF alcanza dicho valor en el limite superior cuando r es grande, \
el grafico normalizado estar\[AAcute] contenido entre cero y uno. "
}], "Text",
 CellChangeTimes->{{3.995118586029853*^9, 
  3.995118743943494*^9}},ExpressionUUID->"2f45a10f-7c42-47bd-b341-\
c645ce26991e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"KBB", "=", 
   RowBox[{
    RowBox[{"Pi", "^", "2"}], "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datosNorm", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "/", "KBB"}]}], "}"}], "&"}], "/@", 
    "datos"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9951187642552843`*^9, 3.995118780589121*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"72c8069b-b35e-4cb8-9327-58e6243cb621"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogLinearPlot", "[", 
  RowBox[{"datosNorm", ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<r = g_R^2/g_L^2\>\"", ",", "14"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<KBF / KBB\>\"", ",", "14"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.995118793588992*^9, 
  3.995118825327197*^9}},ExpressionUUID->"dc2ec596-2fb4-4c14-a633-\
710fe94778b3"],


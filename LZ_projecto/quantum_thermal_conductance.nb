      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"7", "/", "4"}], "*", 
         RowBox[{"Zeta", "[", "3", "]"}]}], "-", 
        RowBox[{
         RowBox[{"31", "/", "16"}], "*", 
         RowBox[{"Zeta", "[", "5", "]"}]}]}], ")"}], "/", "T"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Construcci\[OAcute]n", " ", "de", " ", "las", " ", "aproximaciones", " ",
      "de", " ", "Taylor", " ", "para", " ", "la", " ", "Conductancia"}], 

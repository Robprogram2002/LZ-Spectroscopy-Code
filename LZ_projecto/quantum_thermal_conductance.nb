      RowBox[{"(", 
       RowBox[{"r", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "r"}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "*", 
          RowBox[{
           RowBox[{"Sech", "[", 
            RowBox[{"x", "/", "2"}], "]"}], "^", "2"}]}], ")"}], "/", "4"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Sistema", " ", "H\[IAcute]brido"}], ",", 
     RowBox[{"Central", " ", "Bos\[OAcute]nico", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"+", "1"}], ",", 
        RowBox[{"+", "1"}], ",", 
        RowBox[{"-", "1"}]}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"KappaHibridoB", "[", 
      RowBox[{"r_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "/", 
        RowBox[{"(", 

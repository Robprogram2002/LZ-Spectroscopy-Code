  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Coeficiente", " ", "lineal"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"K00", "[", "T_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"7", "/", "4"}], ")"}], "*", 
      RowBox[{"Zeta", "[", "3", "]"}], "*", "T"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Coeficiente", " ", "de", " ", "rectificaci\[OAcute]n", " ", 
     RowBox[{"(", 
      RowBox[{"Independiente", " ", "de", " ", "T"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K1", ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"5", "/", "4"}], ")"}], "*", 
      RowBox[{"Zeta", "[", "3", "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Coeficiente", " ", "no", " ", "lineal", " ", "de", " ", "orden", " ", 

  3.99511574202932*^9, 
  3.995115749974921*^9}},ExpressionUUID->"018726c3-fbfb-4d6c-9c6b-\
14cdf4497f94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sistema", " ", "completamente", " ", "Bos\[OAcute]nico", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 

    RowBox[{"eqZ", ",", "\[Alpha]z", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", " ", 
     RowBox[{"AccuracyGoal", "->", "10"}], ",", " ", 
     RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ";"}]}], "Input",

    RowBox[{"t", ",", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 

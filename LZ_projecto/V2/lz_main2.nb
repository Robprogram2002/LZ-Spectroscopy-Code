Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ecuacionesOptimizadas", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", "I"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalDelta]", "[", "t", "]"}], " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{
           FractionBox["\[CapitalOmega]", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], "^", "2"}], " ", "-", " ", "1"}], 
            ")"}]}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "*", 
           RowBox[{"x", "[", "t", "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", "^", "2"}], ")"}], "*", "t"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"I", "*", 
           RowBox[{"\[CapitalOmega]", "/", "2"}]}], ")"}]}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", "*", 
          RowBox[{"y", "[", "t", "]"}]}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "t0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"y", "[", "t0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"z", "[", "t0", "]"}], "==", "0"}]}], "}"}]}], ";"}], 
  " "}]], "Input",

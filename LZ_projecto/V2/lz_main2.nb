Cell["Evolution Operator", "Text",
 CellChangeTimes->{{3.991999683581627*^9, 
  3.9919996870883102`*^9}},ExpressionUUID->"c6a14d6b-5194-4d17-9221-\
6e90cb55ee36"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"alphaZ", "[", "t", "]"}], "]"}], "+", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
         RowBox[{"alphaMin", "[", "t", "]"}], " ", 
         RowBox[{"alphaMas", "[", "t", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
        RowBox[{"alphaMas", "[", "t", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
        RowBox[{"alphaMin", "[", "t", "]"}]}], ",", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.991999634674704*^9, 3.991999670706325*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"8c3552d0-6af7-464f-8b96-c2b8e6eddd66"],

Cell[CellGroupData[{

Cell["Integrals as ODEs", "Subsection",
 CellChangeTimes->{{3.991999936604699*^9, 
  3.9919999446458883`*^9}},ExpressionUUID->"3ce199c0-e412-4515-87e3-\
edb356945b13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SpectrumIntegrals", "[", 
   RowBox[{
    RowBox[{"\[Omega]_", "?", "NumericQ"}], ",", 
    RowBox[{"\[CapitalGamma]_", "?", "NumericQ"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"I1", ",", "I2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"I1", "=", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y1", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[CapitalGamma]", "-", 
                RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{
             RowBox[{"alphaMin", "[", "t", "]"}], "^", "2"}]}]}], ",", 
          RowBox[{
           RowBox[{"y1", "[", "t0", "]"}], "==", "0"}]}], "}"}], ",", "y1", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "t0", ",", "tf"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"I2", "=", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y2", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[CapitalGamma]", "-", 
                RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
            RowBox[{"alphaMin", "[", "t", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"y2", "[", "t0", "]"}], "==", "0"}]}], "}"}], ",", "y2", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "t0", ",", "tf"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"I1", ",", "I2"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9920272102824497`*^9, 3.992027210282481*^9}, {
  3.992027274641899*^9, 3.992027282385968*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"2b402bfc-90bb-4ac9-85fd-1d7880be1c6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Spectrum", "[", 
    RowBox[{"\[Omega]_", ",", "\[CapitalGamma]_"}], "]"}], "[", "t_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"I1", ",", "I2"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"I1", ",", "I2"}], "}"}], "=", 
      RowBox[{"SpectrumIntegrals", "[", 
       RowBox[{"\[Omega]", ",", "\[CapitalGamma]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"2", " ", "\[CapitalGamma]", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", "t"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"I1", "[", "t", "]"}], "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"I2", "[", "t", "]"}], "]"}], "^", "2"}]}], ")"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.992027340067572*^9, 3.99202735382292*^9}, 
   3.992027385018341*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"f3e3294e-91d0-43e0-9305-68a7e0f13fd5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"Function", "[", 
    RowBox[{"t", ",", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
      RowBox[{
       RowBox[{"alphaMin", "[", "t", "]"}], "^", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g2", "=", 

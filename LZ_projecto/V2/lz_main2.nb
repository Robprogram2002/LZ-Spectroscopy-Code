Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"curvasTeoricas", "=", 
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Rama", " ", "Diab\[AAcute]tica"}], "+", 
         RowBox[{
          RowBox[{"(", "Derecha", ")"}], " ", "e", " ", "Izquierda"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ",", "t"}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[Beta]", "^", "2"}]}], "*", "t"}], ",", "t"}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Rama", " ", "Adiab\[AAcute]tica"}], "+", 
          RowBox[{
           RowBox[{"(", "Derecha", ")"}], " ", "e", " ", "Izquierda"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ")"}], "^", "2"}], "+", 
            RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}], ",", "t"}], "}"}],
         ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ")"}], "^", "2"}], 
             "+", 
             RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], ",", "t"}], 
         "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "CONFIGURACI\[CapitalOAcute]N"}]}], " ", "DE", " ", 
         RowBox[{"ESTILOS", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Diab\[AAcute]tica", "+"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Diab\[AAcute]tica", "-"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Directive", "[", 
          RowBox[{"White", ",", "Dashed", ",", 
           RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Adiab\[AAcute]tica", "+"}], "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"Directive", "[", 
          RowBox[{"White", ",", "Dashed", ",", 
           RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}]}], 
        "          ", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Adiab\[AAcute]tica", "-"}], "*)"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Quitamos", " ", "los", " ", "ejes", " ", "propios", " ", "del", " ", 
        "ParametricPlot", " ", "para", " ", "que", " ", "no", " ", 
        "interfieran", " ", "con", " ", "el", " ", "mapa"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 

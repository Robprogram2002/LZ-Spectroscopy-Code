     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]z", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", "/", "2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalOmega]", "*", 
          RowBox[{"alphaMas", "[", "t", "]"}]}], "-", 
         RowBox[{"\[CapitalDelta]", "[", "t", "]"}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[Alpha]z", "[", "t0", "]"}], "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alphaZ", "=", 

(* Beginning of Notebook Content *)
Notebook[{
Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<all\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9920956827525587`*^9, 3.992095721984726*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"144009a0-f976-4b03-ad06-7ad483bea2ae"],

Cell[TextData[{
 "We take \[CapitalOmega] as the reference frequency and set its numerical \
value to 1 (\[HBar]\[CapitalOmega] will be the fundamental unit of energy  of \
the system)\n\nIn order to guarantee that the detector has enough resolution \
to \[OpenCurlyDoubleQuote]see\[CloseCurlyDoubleQuote] // \
\[OpenCurlyDoubleQuote]capture\[CloseCurlyDoubleQuote] the interference peaks \
without the relaxation \nthicken the main peaks of the spectrum we fixed the \
ratio \[CapitalOmega] / \[CapitalGamma] to 4. Thus we set \[CapitalGamma] = \
0.25. \n\nSince the probability of a non-adiabatic transition is dictated by \
the ratio \[CapitalOmega] / \[Beta]   through   exp ( - \[Pi] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalOmega]", "2"], TraditionalForm]],ExpressionUUID->
  "62bfccf6-1767-4fc7-8596-684078c11bd4"],
 " / 2 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "190e6d6d-3c16-455d-b43d-38fef4c8002f"],
 " )  and we have fixed the value of \[CapitalOmega], the only parameter that \
governs the dynamical behavior of the qubit-laser coupling is the value of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "fa855e5e-cc17-4379-8311-f28f66902dd8"],
 ". \n\nWe want to analyze how the characteristics of the ideal stationary \
fluorescence spectrum of the system change as we pass from a completely \
adiabatic limit  \[Beta] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessLess]", "1"}], TraditionalForm]],ExpressionUUID->
  "0ac46f02-7ca3-425e-bc06-46117813ab63"],
 " to \[Beta] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tilde]", "1"}], TraditionalForm]],ExpressionUUID->
  "1def2c5a-d161-429e-8166-3cf22dfa060c"],
 ".\n\nAdiabatic limit: \n\[Beta] = 0.3  so ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "b3213d0f-9f8b-4945-a967-b43beeb1a5fe"],
 " = 0.09  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"L", "Z"}], "TI"]], "\[TildeTilde]", 
    RowBox[{"2", "\[Times]", 
     SuperscriptBox["10", 
      RowBox[{"-", "8"}]]}]}], TraditionalForm]],ExpressionUUID->
  "0031a0c1-5b63-45e9-bee7-cdb657cbff59"],
 "\n\nIn this case the emission will follow one of the adiabatic hyperbolic \
branches of the avoided crossing . There will not be  transient (ringing) \
oscillations since there will not be any coherence superposition of paths. \n\
\nNon-adiabatic regime:\n\[Beta]  = 0.5 so ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "6fae59c8-3def-45fc-8966-7ca469fc210b"],
 " = 0.25  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"L", "Z"}], "TI"]], "\[TildeTilde]", "0.08"}], 
   TraditionalForm]],ExpressionUUID->"fd6cedd5-aa99-43df-a90a-2545503967dc"],
 "\n\nTime scale: Instead of plotting the spectrum against time $t$, spectrum \
should be plot it against the instantaneous dimensionless detuning:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "\[LongEqual]", 
    FractionBox[
     RowBox[{"\[CapitalDelta]", "(", 
      StyleBox["t", "TI"], ")"}], "\[CapitalOmega]"], "\[LongEqual]", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[Beta]", "2"], 
      StyleBox["t", "TI"]}], "\[CapitalOmega]"]}], TraditionalForm]],
  ExpressionUUID->"8f969d0f-fbc4-46a1-aabd-f139f4e0e5d9"],
 "\n\nSince we already fixed \[CapitalOmega] to 1 we only need to change the \
time axis t by the axis ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "b5a0dcbc-4416-4290-9304-75b559de82ee"],
 "t. \n\nIn this way we don\[CloseCurlyQuote]t need to use different time \
scales to \[OpenCurlyDoubleQuote]see\[CloseCurlyDoubleQuote] the transition \
for different values of the rate ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "07cb6b11-4679-4e95-b843-25ffb97ef85f"],
 ". Otherwise the avoided crossings will appear distorted (some very \
stretched, others very squashed), ruining the direct comparison.\n\nIn this \
way the adiabatic lines of the avoided crossing , the X shape, will have the \
same step and the same geometric aperture for different rates of change ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "531015ab-b239-4b11-b1c7-42ece85b2778"],
 ". This will allow the reader to see different density maps side by side and \
observe exclusively how the intensity of light decides which path to take in \
the face of the same band structure.\n\nFrequency scale and axis: \
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[IndentingNewLine]", 
    RowBox[{
     SubscriptBox["\[Omega]", "max"], "\[TildeTilde]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[PlusMinus]", "\[Beta]"}], "2"], 
      SubscriptBox[
       StyleBox["t", "TI"], "max"]}]}]}], TraditionalForm]],ExpressionUUID->
  "dd53da41-793e-4fc6-ad4e-b838ce0c1c72"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "borde"], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Beta]", "2"], 
      SubscriptBox[
       StyleBox["t", "TI"], "max"]}], "+", "Margin"}]}], TraditionalForm]],
  ExpressionUUID->"4a7beaa0-58d4-41c4-8a4f-9b62321e7818"],
 "\n\nMargin = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CapitalOmega]"}], TraditionalForm]],ExpressionUUID->
  "d4ae6339-f622-48b7-a6b7-40556f70b9d9"],
 "\n\nAvoided Crossing: \n\nDiabatic lines (non-coupled states) : ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "diab"], "(", 
     StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     RowBox[{"\[CapitalDelta]", "(", 
      StyleBox["t", "TI"], ")"}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"\[PlusMinus]", " ", 
      SuperscriptBox["\[Beta]", "2"]}], 
     StyleBox["t", "TI"]}]}], TraditionalForm]],ExpressionUUID->
  "103c391e-a775-403b-a1f6-58bfd905a566"],
 "\nAdiabatic lines (coupled states, instantaneous energy eigenvalues):   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "adiab"], "(", 
     StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SqrtBox[
      RowBox[{
       RowBox[{"\[CapitalDelta]", 
        SuperscriptBox[
         RowBox[{"(", 
          StyleBox["t", "TI"], ")"}], "2"]}], "+", 
       SuperscriptBox["\[CapitalOmega]", "2"]}]]}], "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["\[Beta]", "2"], 
          StyleBox["t", "TI"]}], ")"}], "2"], "+", 
       SuperscriptBox["\[CapitalOmega]", "2"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"bea4c59a-6dca-474c-b937-b02773d15fc9"]
}], "Text",
 CellChangeTimes->{{3.991493849979969*^9, 3.99149431801124*^9}, {
  3.991494363785428*^9, 3.991494587288472*^9}, {3.991494638092654*^9, 
  3.9914947653328323`*^9}, {3.991494812766923*^9, 3.991494972396456*^9}, {
  3.991495075496538*^9, 3.99149533655162*^9}, {3.991495381553534*^9, 
  3.9914954940764*^9}, {3.991497414033197*^9, 3.991497476364176*^9}, {
  3.991498751857914*^9, 3.991498856431946*^9}, {3.992026331780367*^9, 
  3.99202633212703*^9}},ExpressionUUID->"8aee9b81-d353-4c2d-912d-\
64150aed974d"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9919977191927357`*^9, 3.991997719192769*^9}},
 CellLabel->
  "In[141]:=",ExpressionUUID->"07c2b281-491b-4093-874c-765a647fb606"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Beta]", "=", "0.25"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "=", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]", " ", "=", " ", "0.25"}], "  ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Beta]", "^", "2"}], " ", ")"}], "t"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]dot", ":=", 
    RowBox[{"\[Beta]", "^", "2"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"t0", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "10"}], "*", " ", 
     RowBox[{"(", 
      FractionBox["\[CapitalOmega]", 
       RowBox[{"\[Beta]", "^", "2"}]], ")"}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tf", " ", "=", " ", 
   RowBox[{"10", "*", 
    RowBox[{"(", 
     FractionBox["\[CapitalOmega]", 
      RowBox[{"\[Beta]", "^", "2"}]], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991999453132352*^9, 3.991999464674094*^9}, {
  3.9920256763051367`*^9, 3.992025682542817*^9}, {3.9920262305288467`*^9, 
  3.99202623110303*^9}, {3.99203073287071*^9, 3.992030736102343*^9}, {
  3.9920945855245047`*^9, 3.99209458955827*^9}, {3.992097001643689*^9, 
  3.992097001779521*^9}, {3.9920972515668163`*^9, 3.992097251830193*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"4d3cb2d0-c5f6-4e92-b895-eb5762bec412"],

Cell[CellGroupData[{

Cell["Evaluation of the system of equations V2", "Section",
 CellChangeTimes->{{3.9919977019711246`*^9, 
  3.9919977172318983`*^9}},ExpressionUUID->"3a395928-2bf4-4821-8730-\
282643ab9a8b"],

Cell["\<\
The system of equations for the alpha functions can be algebraically resolved \
into three equations. Basically, all the dynamic information of the problem \
is encoded in the first Riccati equation.  

Instead of solving this non-linear 1st order ODE \
\>", "Text",
 CellChangeTimes->{{3.991997808282145*^9, 3.9919978884678373`*^9}, 
   3.99199836169776*^9, {3.992001500221755*^9, 
   3.992001719676293*^9}},ExpressionUUID->"fe6aebb8-6c08-4158-87f0-\
e6b3eb3b8220"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqPlus", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Alpha]p", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"-", "I"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[CapitalDelta]", "[", "t", "]"}], " ", 
          RowBox[{"\[Alpha]p", "[", "t", "]"}]}], " ", "-", " ", 
         RowBox[{
          FractionBox["\[CapitalOmega]", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Alpha]p", "[", "t", "]"}], "^", "2"}], " ", "-", " ", 
            "1"}], ")"}]}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[Alpha]p", "[", "t0", "]"}], "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alphaMas", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{"eqPlus", ",", "\[Alpha]p", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", " ", 
     RowBox[{"AccuracyGoal", "->", "10"}], ",", " ", 
     RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992001737788151*^9, 3.9920018317988777`*^9}, {
   3.9920018683013372`*^9, 3.992001868503312*^9}, 3.9920262970852623`*^9, {
   3.992026734560727*^9, 3.9920267358981524`*^9}, {3.9920322035443487`*^9, 
   3.9920322039050407`*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"78702cd4-aa10-4064-8388-829e91e13eea"],

Cell[TextData[{
 "we apply the usual change of variable: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"       ", 
    SubscriptBox["\[Alpha]", "+"]}], TraditionalForm]],ExpressionUUID->
  "8a1332d0-137d-49b0-9416-4f45f3e8fa61"],
 "(t) = - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     RowBox[{"c", "(", "t", ")"}]], 
    FractionBox[
     RowBox[{
      RowBox[{"u", "'"}], 
      RowBox[{"(", "t", ")"}]}], 
     RowBox[{"u", "(", "t", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "a0b3cfd3-9ba0-4b3a-a80d-54555527c686"],
 ",   to transform the equation into a 2nd order ODE for u(t)"
}], "Text",
 CellChangeTimes->{
  3.992001724885531*^9},ExpressionUUID->"a4a1d8d7-4923-4d9c-94db-\
a74969d33dda"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqU", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"u", "''"}], "[", "t", "]"}], "+", 
       RowBox[{"I", " ", 
        RowBox[{"\[CapitalDelta]", "[", "t", "]"}], " ", 
        RowBox[{
         RowBox[{"u", "'"}], "[", "t", "]"}]}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalOmega]", "^", "2"}], "/", "4"}], " ", 
        RowBox[{"u", "[", "t", "]"}]}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", "t0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "'"}], "[", "t0", "]"}], "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uSol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{"eqU", ",", "u", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alphaMas2", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"I", "/", "\[CapitalOmega]"}]}], ")"}], 
    RowBox[{
     RowBox[{
      RowBox[{"uSol", "'"}], "[", "t", "]"}], "/", 
     RowBox[{"uSol", "[", "t", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99200143285686*^9, 3.992001432856892*^9}, {
   3.9920018981037397`*^9, 3.992001901854516*^9}, 3.9920262996310043`*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"35af06fc-6c04-4d07-b1a0-792749c02707"],

Cell[TextData[{
 "More over, we can apply a second change of variable to eliminate de 1st \
order derivate of the previous equation:   u(t)=exp[\[Minus]  ",
 Cell[BoxData[
  FormBox[
   FractionBox["i", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2756a407-5b1d-4f69-8257-9a091631963a"],
 "\:200b\[Integral] \[CapitalDelta](s)ds ] v(t),\n\nThe resulting equation \
for v(t) is  :     v\[CloseCurlyQuote]\[CloseCurlyQuote](t) + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox[
     RowBox[{"\[CapitalOmega]", "^", "2"}], "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "123d284d-d372-4472-8c2c-1357ecc56106"],
 " +  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[CapitalDelta]", "^", "2"}], "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b3e646b-bdb3-48f3-8a36-01fb02d6a83a"],
 "- ",
 Cell[BoxData[
  FormBox[
   FractionBox["i", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a8181a33-d6e5-4c2f-9fc6-88fb39cd972d"],
 "\[CapitalDelta]\[CloseCurlyQuote]  ) v(t) = 0\nwith initial conditions:     \
 v(t0\:200b)=1    ,    v\[CloseCurlyQuote](t0) = ",
 Cell[BoxData[
  FormBox[
   FractionBox["i", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1a0df30f-bedc-43f9-b862-ec6248a7ee61"],
 "\[CapitalDelta](t0)\n\nAnd the reconstruction of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "61594bdf-f5c7-41d7-af46-19c566c105d5"],
 " follows as :   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "+"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ec444f2b-bcd8-4edb-b7bc-170bfc056645"],
 " = ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[CapitalDelta]", "[", "t", "]"}], "\[CapitalOmega]"], " ", "+", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", " ", "I"}], "\[CapitalOmega]"], ")"}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"v", "'"}], "[", "t", "]"}], 
      RowBox[{"v", "[", "t", "]"}]]}]}], ";"}]], "Input",
  CellChangeTimes->{{3.9920259104507647`*^9, 3.992026084109812*^9}, {
   3.992026120248438*^9, 3.992026144763699*^9}},ExpressionUUID->
  "5daeab49-ab96-428b-ab90-55428c49cc68"]
}], "Text",
 CellChangeTimes->{{3.992025438257702*^9, 3.9920254738816433`*^9}, {
   3.9920255574593363`*^9, 3.992025603282381*^9}, {3.992025658189831*^9, 
   3.9920256585639477`*^9}, {3.992025692621784*^9, 3.992025857530459*^9}, 
   3.992025906926278*^9, {3.992026151471216*^9, 
   3.992026197175034*^9}},ExpressionUUID->"5c3903b1-0df7-4f86-9821-\
f2f6d9ec5f19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqV", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"v", "''"}], "[", "t", "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[CapitalOmega]", "^", "2"}], "4"], "+", " ", 
          FractionBox[
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "t", "]"}], "^", "2"}], "4"], "-",
           " ", 
          RowBox[{"I", " ", 
           FractionBox["\[CapitalDelta]dot", "2"]}]}], ")"}], 
        RowBox[{"v", "[", "t", "]"}]}]}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"v", "[", "t0", "]"}], "==", " ", "1"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "'"}], "[", "t0", "]"}], "==", " ", 
      RowBox[{
       FractionBox["I", "2"], " ", 
       RowBox[{"\[CapitalDelta]", "[", "t0", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vSol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{"eqV", ",", "v", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alphaMas", "[", "t_", "]"}], ":=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"\[CapitalDelta]", "[", "t", "]"}], "\[CapitalOmega]"], " ", "+", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", " ", "I"}], "\[CapitalOmega]"], ")"}], " ", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"vSol", "'"}], "[", "t", "]"}], 
       RowBox[{"vSol", "[", "t", "]"}]], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992017768002158*^9, 3.9920177693479033`*^9}, {
   3.9920184635695677`*^9, 3.992018536148875*^9}, {3.9920185873778343`*^9, 
   3.992018604810541*^9}, {3.992032756968873*^9, 3.992032758392543*^9}, 
   3.992033362747821*^9, {3.9920334433518553`*^9, 3.992033468085333*^9}, 
   3.99209451053023*^9, {3.99209464428209*^9, 3.992094648229144*^9}, {

Cell[BoxData[
 RowBox[{
  RowBox[{"specSolver", "=", 
   RowBox[{"ParametricNDSolveValue", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y1", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalGamma]", "-", 
              RowBox[{"I", " ", "\[Omega]"}]}], ")"}], " ", "t"}], "]"}], " ", 
          RowBox[{"g1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y2", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalGamma]", "-", 
              RowBox[{"I", " ", "\[Omega]"}]}], ")"}], " ", "t"}], "]"}], " ", 
          RowBox[{"g2", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"y1", "[", "t0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"y2", "[", "t0", "]"}], "==", "0"}]}], "\[IndentingNewLine]",
        "}"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y1", ",", "y2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", "\[Omega]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"AccuracyGoal", "->", "12"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PrecisionGoal", "->", "12"}], ",", "\[IndentingNewLine]", 
     RowBox[{"MaxSteps", "->", "Infinity"}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.9920280085048637`*^9, 3.992028055747127*^9}, {
  3.9920281445724077`*^9, 3.992028162416766*^9}, {3.992028204176161*^9, 

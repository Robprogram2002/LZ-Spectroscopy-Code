Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Definimos", " ", "un", " ", "umbral", " ", "m\[IAcute]nimo", " ",
     "para", " ", "evitar", " ", "el", " ", "error", " ", "de", " ", 
    RowBox[{
     RowBox[{"Log10", "[", "0", "]"}], ".", "Un"}], " ", "valor", " ", "de", " ", 

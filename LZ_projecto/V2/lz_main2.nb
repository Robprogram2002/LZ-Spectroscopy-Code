Cell[BoxData[
 RowBox[{
  RowBox[{"curvasTeoricas", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Rama", " ", 
        RowBox[{"Diab\[AAcute]tica", ":", 
         RowBox[{"{", 
          RowBox[{"frecuencia", ",", "desinton\[IAcute]a"}], "}"}]}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ",", 
         RowBox[{
          RowBox[{"\[Beta]", "^", "2"}], "*", "t"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"\[Beta]", "^", "2"}]}], "*", "t"}], ",", 
         RowBox[{
          RowBox[{"\[Beta]", "^", "2"}], "*", "t"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Rama", " ", 
         RowBox[{"Adiab\[AAcute]tica", ":", 
          RowBox[{"{", 
           RowBox[{"frecuencia", ",", "desinton\[IAcute]a"}], "}"}]}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ")"}], "^", "2"}], "+", 
           RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"\[Beta]", "^", "2"}], "*", "t"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ")"}], "^", "2"}], "+", 
            RowBox[{"\[CapitalOmega]", "^", "2"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Beta]", "^", "2"}], "*", "t"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", 
          RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", 
          RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", "Dashed", ",", 
          RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", "Dashed", ",", 
          RowBox[{"AbsoluteThickness", "[", "2.5", "]"}]}], "]"}]}], "}"}]}], 
     ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9914999759623632`*^9, 
  3.9915000206627493`*^9}},ExpressionUUID->"8f260927-8eb6-4bca-bdb7-\
343c400e95a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Aproximaci\[OAcute]n de tiempos grandes", "Section",
 CellChangeTimes->{{3.994519228368469*^9, 
  3.994519235398176*^9}},ExpressionUUID->"4748a519-48cd-4867-a364-\
d5b8c5db0db7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SAnalitico", "[", 
    RowBox[{"omega_", ",", "t_", ",", "Gamma_", ",", "beta_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", ",", "prefactor"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], "*", 
            RowBox[{"Pi", "/", "4"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "beta"}], ")"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"Gamma", "-", 
          RowBox[{"I", "*", 
           RowBox[{"(", 
            RowBox[{"omega", "-", 
             RowBox[{"2", "*", 
              RowBox[{"beta", "^", "2"}], "*", "t"}]}], ")"}]}]}], ")"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"prefactor", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Pi", "*", "Gamma"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"beta", "^", "2"}]}], ")"}]}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Gamma", "/", 
            RowBox[{"beta", "^", "2"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"omega", "-", 
            RowBox[{"2", "*", 
             RowBox[{"beta", "^", "2"}], "*", "t"}]}], ")"}]}], "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Devolvemos", " ", "la", " ", "funci\[OAcute]n", " ", "completa", " ", 
        "usando", " ", "Erfc"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"prefactor", "*", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Erfc", "[", "u", "]"}], "]"}], "^", "2"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.994519236161148*^9, 3.99451926498129*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"38172aa2-1e77-4803-89e6-37bfec6a2f4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Creaci\[OAcute]n", " ", "de", " ", "los", " ", "contornos", " ",
     "de", " ", "la", " ", "aproximaci\[OAcute]n"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Mantenemos", " ", "el", " ", "mismo", " ", "epsilon", " ", "que", " ", 
    "usamos", " ", "para", " ", "los", " ", "datos", " ", 
    "num\[EAcute]ricos"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"epsilon", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"trazasAproximacion", "=", 
     RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Evaluamos", " ", "la", " ", "funci\[OAcute]n", " ", "en", " ", "el", 
         " ", "tiempo", " ", "f\[IAcute]sico", " ", "t"}], "=", 
        RowBox[{
         RowBox[{"tauY", "/", 
          RowBox[{"beta", "^", "2"}]}], " ", "para", " ", "que", " ", "se", " ",
          "alinee", " ", "con", " ", "el", " ", "mapa", " ", "de", " ", 

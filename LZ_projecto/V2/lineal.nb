        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalGamma]", "-", 
            RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}]}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], 
       RowBox[{
        RowBox[{"alphaMenos", "[", "t", "]"}], "^", "2"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", "T0", " ", ",", " ", "T"}], "}"}], ",", " ", 
      RowBox[{"MaxRecursion", "->", "20"}]}], "]"}], "]"}], "^", 
   "2"}]}]], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"I1", "[", 
   RowBox[{
   "\[CapitalGamma]_", ",", " ", "\[Omega]_", ",", " ", "T_", ",", " ", 
    "T0_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{

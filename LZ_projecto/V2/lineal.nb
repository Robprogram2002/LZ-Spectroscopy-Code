Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"EWLinear", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Beta]_", ",", "\[Omega]_", ",", "T_"}], "]"}],
    ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Pi]", " ", "\[CapitalGamma]"}], 
     RowBox[{"2", " ", 
      SuperscriptBox["\[Beta]", "2"]}]], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", 
      RowBox[{"(", 
       RowBox[{"T", "-", 
        RowBox[{"\[Omega]", " ", "/", 
         RowBox[{"(", 
          RowBox[{"2", 
           RowBox[{"\[Beta]", "^", "2"}]}], ")"}]}]}], ")"}]}], "]"}], 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Erfc", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], ")"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalGamma]", "-", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"\[Omega]", "-", 
              RowBox[{"2", "T", " ", 
               RowBox[{"\[Beta]", "^", "2"}]}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "\[Beta]"}], ")"}]}]}], "]"}], "]"}], "^", "2"}]}]}],
  FontSize->24]], "Input",
 CellLabel->
  "In[402]:=",ExpressionUUID->"4411264b-7762-481f-9d31-bd84f2175e24"],


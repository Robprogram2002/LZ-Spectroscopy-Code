Cell[BoxData[
 RowBox[{
  RowBox[{"I1", "[", 
   RowBox[{
   "\[CapitalGamma]_", ",", " ", "\[Omega]_", ",", " ", "T_", ",", " ", 
    "T0_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalGamma]", "-", 
           RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], 
       RowBox[{"Sin", "[", 
        FractionBox[
         RowBox[{"t", " ", "\[CapitalOmega]n"}], "2"], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", "T0", " ", ",", " ", "T"}], "}"}], ",", " ", 
      RowBox[{"MaxRecursion", "->", "20"}]}], "]"}], "]"}], "^", 
   "2"}]}]], "Input",
 CellChangeTimes->{{3.9602845493379803`*^9, 3.960284572465539*^9}, {

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"SepectroEstadoCoherente", "[", 
    RowBox[{
    "\[CapitalOmega]_", ",", "\[CapitalGamma]_", ",", "\[Omega]_", ",", "t_", 
     ",", "\[Alpha]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"Abs", "[", "\[Alpha]", "]"}], "^", "2"}]}], "]"}], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "\[Alpha]", "]"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "n"}], "+", "2"}], ")"}]}], 
       RowBox[{
        RowBox[{"MollowDetuning", "[", 
         RowBox[{
         "\[CapitalOmega]", ",", "\[CapitalGamma]", ",", "\[Omega]", ",", "t",
           ",", "n"}], "]"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], "!"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        StyleBox[
         RowBox[{"3", "0"}]]}], "}"}]}], "]"}]}]}],
  FontSize->24]], "Input",
 CellChangeTimes->{{3.686689712146574*^9, 3.686689764442577*^9}, {
   3.686689795897469*^9, 3.68668983102876*^9}, {3.686690315426794*^9, 

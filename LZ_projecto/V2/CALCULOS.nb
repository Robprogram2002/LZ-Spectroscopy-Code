Cell[BoxData[
 RowBox[{
  RowBox[{"I2", "[", 
   RowBox[{
   "\[CapitalGamma]_", ",", " ", "\[Omega]_", ",", " ", "T_", ",", " ", 
    "T0_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalGamma]", "-", 
           RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"Sin", "[", 
           RowBox[{"t", " ", "\[CapitalOmega]n"}], "]"}], "2"], "+", 
         RowBox[{
          FractionBox[
           RowBox[{"I", " ", "\[CapitalDelta]"}], "\[CapitalOmega]n"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sin", "[", 

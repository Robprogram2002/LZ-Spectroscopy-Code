Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "I"}], " ", "\[CapitalOmega]"}], "-", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{"\[Beta]", "^", "2"}], ")"}], "t", " ", 
      RowBox[{"x", "[", "t", "]"}]}], "+", 
     RowBox[{"I", " ", "\[CapitalOmega]", " ", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], "^", "2"}]}]}]}], ",", 
   RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.960278477404029*^9, 3.960278482952539*^9}, {
  3.960278526598092*^9, 3.960278609566147*^9}, {3.9602786447544107`*^9, 
  3.960278729718616*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"57a17a70-5d69-40a0-8e9a-267c93ad5a17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          TemplateBox[{"1"},
           "C"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", 
                FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
               SuperscriptBox["t", "2"], " ", 
               SuperscriptBox["\[Beta]", "2"]}]], " ", "t", " ", 
             SuperscriptBox["\[Beta]", "2"], " ", 
             RowBox[{"HermiteH", "[", 
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{"-", 
                  SuperscriptBox["\[Beta]", "2"]}], "-", 
                 RowBox[{"\[ImaginaryI]", " ", 
                  SuperscriptBox["\[CapitalOmega]", "2"]}]}], 
                SuperscriptBox["\[Beta]", "2"]], ",", 
               FractionBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], 
                  RowBox[{"1", "/", "4"}]], " ", "t", " ", "\[Beta]"}], 
                SqrtBox["2"]]}], "]"}]}], "+", 
            FractionBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], 
               RowBox[{"1", "/", "4"}]], " ", 
              SqrtBox["2"], " ", 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                RowBox[{"-", 
                 FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
                SuperscriptBox["t", "2"], " ", 
                SuperscriptBox["\[Beta]", "2"]}]], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["\[Beta]", "2"]}], "-", 
                RowBox[{"\[ImaginaryI]", " ", 
                 SuperscriptBox["\[CapitalOmega]", "2"]}]}], ")"}], " ", 
              RowBox[{"HermiteH", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "1"}], "+", 
                 FractionBox[
                  RowBox[{
                   RowBox[{"-", 
                    SuperscriptBox["\[Beta]", "2"]}], "-", 
                   RowBox[{"\[ImaginaryI]", " ", 
                    SuperscriptBox["\[CapitalOmega]", "2"]}]}], 
                  SuperscriptBox["\[Beta]", "2"]]}], ",", 
                FractionBox[
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], 

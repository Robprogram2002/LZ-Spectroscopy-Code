Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ecuacionesOptimizadas", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"I", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], "*", 

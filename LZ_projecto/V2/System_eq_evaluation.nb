Cell[BoxData[{
 RowBox[{
  RowBox[{"condicionesU", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", "t0", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "'"}], "[", "t0", "]"}], "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"condicionesVt", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"v", "[", "t0", "]"}], "==", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", "*", 
        RowBox[{"\[Beta]", "^", "2"}], "*", 
        RowBox[{
         RowBox[{"t0", "^", "2"}], "/", "4"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "'"}], "[", "t0", "]"}], "==", 
      RowBox[{"I", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Beta]", "^", "2"}], "*", 
         RowBox[{"t0", "/", "2"}]}], ")"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", "*", 
         RowBox[{"\[Beta]", "^", "2"}], "*", 
         RowBox[{
          RowBox[{"t0", "^", "2"}], "/", "4"}]}], "]"}]}]}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.992052177783739*^9, 
  3.992052223196685*^9}},ExpressionUUID->"1eee3b3c-6bf8-4ff7-81e4-\
5d2d10e7491a"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"uExact", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"vExact", "[", "t", "]"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], "*", 
        RowBox[{"\[Beta]", "^", "2"}], "*", 
        RowBox[{
         RowBox[{"t", "^", "2"}], "/", "4"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"uExactDeriv", "[", "t_", "]"}], "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"uExact", "[", "t", "]"}], ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"alphaExact", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"I", "/", "\[CapitalOmega]"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"uExactDeriv", "[", "t", "]"}], "/", 
        RowBox[{"uExact", "[", "t", "]"}]}], ")"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{
  3.992052179797394*^9, {3.992052215286933*^9, 3.992052225456319*^9}, {
   3.992052459655704*^9, 3.992052461126486*^9}},
 CellLabel->
  "In[380]:=",ExpressionUUID->"87c428df-dcac-4a56-b8a4-519ff2fd79de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Ecuaci\[OAcute]n", ":", 
     RowBox[{
      RowBox[{"i", " ", "\[Alpha]"}], "+", "'", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Lambda]", "/", "2"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"\[Alpha]", "+", 
         RowBox[{"^", "2"}], "-", "1"}], ")"}]}], "-", 
      RowBox[{"\[CapitalDelta]", 
       RowBox[{"(", "t", ")"}], "\[Alpha]"}], "+"}]}], " ", "=", "0"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"solAlpha", "=", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"I", "*", 
             RowBox[{
              RowBox[{"a", "'"}], "[", "t", "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalOmega]", "/", "2"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "[", "t", "]"}], "^", "2"}], "-", "1"}], ")"}]}],
             "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Beta]", "^", "2"}], "*", "t"}], ")"}], "*", 
             RowBox[{"a", "[", "t", "]"}]}]}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"a", "[", "t0", "]"}], "==", "0"}]}], "}"}], ",", "a", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
        RowBox[{"MaxSteps", "->", "100000"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"alphaNum", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"a", "[", "t", "]"}], "/.", " ", "solAlpha"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.992052241669804*^9, 3.992052267121791*^9}, {
  3.992052298297304*^9, 3.992052301603153*^9}},
 CellLabel->
  "In[383]:=",ExpressionUUID->"1c3c3c33-d9c5-4f6d-b43e-2326644eb5a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"alphaErr", "[", "t_", "]"}], ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"alphaNum", "[", "t", "]"}], "-", 
     RowBox[{"alphaExact", "[", "t", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alphaRerr", "[", "t_", "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"alphaErr", "[", "t", "]"}], 
    RowBox[{"Abs", "[", 
     RowBox[{"alphaExact", "[", "t", "]"}], "]"}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992052549819109*^9, 3.99205260281563*^9}},
 CellLabel->
  "In[387]:=",ExpressionUUID->"0a755383-40e8-4e40-8625-ea72402b30d3"],


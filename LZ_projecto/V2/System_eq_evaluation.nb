Cell[BoxData[{
 RowBox[{
  RowBox[{"eqV", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"v", "''"}], "[", "t", "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[CapitalOmega]", "^", "2"}], "4"], "+", " ", 
          FractionBox[
           RowBox[{
            RowBox[{"\[CapitalDelta]", "[", "t", "]"}], "^", "2"}], "4"], "-",
           " ", 
          RowBox[{"I", " ", 
           FractionBox["\[CapitalDelta]dot", "2"]}]}], ")"}], 
        RowBox[{"v", "[", "t", "]"}]}]}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"v", "[", "t0", "]"}], "==", " ", "1"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "'"}], "[", "t0", "]"}], "==", " ", 
      RowBox[{
       FractionBox["I", "2"], " ", 
       RowBox[{"\[CapitalDelta]", "[", "t0", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vSol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{"eqV", ",", "v", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{

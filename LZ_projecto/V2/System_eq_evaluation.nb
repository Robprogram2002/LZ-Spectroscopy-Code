  3.992024618957878*^9}},ExpressionUUID->"33f54ebf-d9df-4d4c-bb0d-\
f8668b9f4c74"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"alphaNum", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "[", "t", "]"}], "/", "\[CapitalOmega]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"I", "/", "\[CapitalOmega]"}]}], ")"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"vNum", "'"}], "[", "t", "]"}], "/", 
      RowBox[{"vNum", "[", "t", "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alphaAna", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", "[", "t", "]"}], "/", "\[CapitalOmega]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"I", "/", "\[CapitalOmega]"}]}], ")"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"vAna", "'"}], "[", "t", "]"}], "/", 
      RowBox[{"vAna", "[", "t", "]"}]}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99202463204574*^9, 3.992024642102289*^9}, {
  3.992092653057206*^9, 3.99209267888793*^9}},
 CellLabel->
  "In[203]:=",ExpressionUUID->"a7dc5a27-b7c3-4a93-a2f5-b0566892978e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"errorAlpha", "[", "t_", "]"}], ":=", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"alphaNum", "[", "t", "]"}], "-", 
     RowBox[{"alphaAna", "[", "t", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RerrorAlpha", "[", "t_", "]"}], ":=", " ", 
   FractionBox[
    RowBox[{"errorAlpha", "[", "t", "]"}], 
    RowBox[{"Abs", "[", 
     RowBox[{"alphaAna", "[", "t", "]"}], "]"}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992024650938801*^9, 3.992024650938834*^9}, {
  3.992025088484005*^9, 3.9920251303604918`*^9}, {3.992092692403502*^9, 
  3.9920927043079967`*^9}},
 CellLabel->
  "In[207]:=",ExpressionUUID->"255a286b-efb4-41f1-b05b-60386324b923"]
}, Open  ]],


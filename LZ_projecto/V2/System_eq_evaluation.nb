        RowBox[{
         RowBox[{"(", 
          RowBox[{"I", "*", 
           RowBox[{"\[CapitalOmega]", "/", "2"}]}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}]}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "*", 
           RowBox[{"x", "[", "t", "]"}]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", "^", "2"}], ")"}], "*", "t"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"I", "*", 
           RowBox[{"\[CapitalOmega]", "/", "2"}]}], ")"}]}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", "*", 
          RowBox[{"y", "[", "t", "]"}]}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "t0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"y", "[", "t0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"z", "[", "t0", "]"}], "==", "0"}]}], "}"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"alphaMas4", ",", " ", "alphaZ", ",", " ", "alphaMin"}], "}"}], "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{"ecuacionesOptimizadas", ",", 
     RowBox[{"{", 

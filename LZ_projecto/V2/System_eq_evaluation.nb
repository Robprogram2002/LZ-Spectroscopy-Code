Cell[CellGroupData[{

Cell["Comparison of solutions", "Subsection",
 CellChangeTimes->{{3.9920514083659477`*^9, 
  3.9920514137426357`*^9}},ExpressionUUID->"04f53003-65a4-47f7-a1eb-\
da10fd96aad1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Beta]", "=", "0.25"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "=", "1.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]", " ", "=", " ", 
   FractionBox[
    RowBox[{"\[CapitalOmega]", "^", "2"}], 
    RowBox[{"2", 
     RowBox[{"\[Beta]", "^", "2"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{
    RowBox[{"-", "10"}], " ", 
    RowBox[{"\[CapitalOmega]", "/", 
     RowBox[{"\[Beta]", "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tf", "=", 
    RowBox[{"10", " ", 
     RowBox[{"\[CapitalOmega]", "/", 
      RowBox[{"\[Beta]", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], ":=", 
   RowBox[{"\[Beta]", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", 
      RowBox[{"Pi", "/", "4"}]}], "]"}], "*", "t"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z0", "=", 
   RowBox[{"z", "[", "t0", "]"}]}], ";", 
  RowBox[{"zf", " ", "=", " ", 
   RowBox[{"z", "[", "tf", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992051653361802*^9, 3.992051706242564*^9}, 
   3.9920518554788837`*^9},
 CellLabel->
  "In[344]:=",ExpressionUUID->"04a2d086-9932-464b-bdf1-d047911eea7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numC1", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"z0", "^", "2"}]}], "/", "4"}], "]"}], "*", 
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], "*", 
       RowBox[{"\[Delta]", "/", "2"}]}], ",", 
      RowBox[{"I", "*", "z0"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"numC2", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"z0", "^", "2"}]}], "/", "4"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ParabolicCylinderD", "[", 
       RowBox[{
        RowBox[{"1", "+", 
         RowBox[{"I", "*", 
          RowBox[{"\[Delta]", "/", "2"}]}]}], ",", "z0"}], "]"}], "-", 
      RowBox[{"z0", "*", 
       RowBox[{"ParabolicCylinderD", "[", 
        RowBox[{
         RowBox[{"I", "*", 
          RowBox[{"\[Delta]", "/", "2"}]}], ",", "z0"}], "]"}]}]}], ")"}]}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.992051435272574*^9, 
  3.992051466499112*^9}},ExpressionUUID->"e50e90cf-e296-4180-9540-\
d8fc02e7bbc7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"C1", "=", 
   RowBox[{"numC1", "/", "W"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"C2", "=", 
   RowBox[{"numC2", "/", "W"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992051514345767*^9, 
  3.992051522305258*^9}},ExpressionUUID->"4bc5a91a-495f-4445-a2ee-\
d1499495badf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vExact", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"c1", "*", 
     RowBox[{"ParabolicCylinderD", "[", 
      RowBox[{
       RowBox[{"I", "*", 
        RowBox[{"\[Delta]", "/", "2"}]}], ",", 
       RowBox[{"z", "[", "t", "]"}]}], "]"}]}], "+", 
    RowBox[{"c2", "*", 
     RowBox[{"ParabolicCylinderD", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        RowBox[{"I", "*", 
         RowBox[{"\[Delta]", "/", "2"}]}]}], ",", 
       RowBox[{"I", "*", 
        RowBox[{"z", "[", "t", "]"}]}]}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.992051488009234*^9, 3.992051530015188*^9, {3.9920520671764*^9, 
   3.9920520706987333`*^9}},
 CellLabel->
  "In[361]:=",ExpressionUUID->"62e76d39-f74d-426f-ac10-36a19a577316"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"condicionesVz", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"v", "[", "z0", "]"}], "==", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"z0", "^", "2"}]}], "/", "4"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "'"}], "[", "z0", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"z0", "/", "2"}], ")"}]}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"z0", "^", "2"}]}], "/", "4"}], "]"}]}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solV", "=", 
    RowBox[{
     RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"v", "''"}], "[", "t", "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Beta]", "^", "4"}], "*", 
               RowBox[{
                RowBox[{"t", "^", "2"}], "/", "4"}]}], "+", 
              RowBox[{
               RowBox[{"\[CapitalOmega]", "^", "2"}], "/", "4"}], "-", 
              RowBox[{"I", "*", 
               RowBox[{
                RowBox[{"\[Beta]", "^", "2"}], "/", "2"}]}]}], ")"}], "*", 
            RowBox[{"v", "[", "t", "]"}]}]}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"v", "[", "t0", "]"}], "==", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", "*", 
            RowBox[{"\[Beta]", "^", "2"}], "*", 
            RowBox[{
             RowBox[{"t0", "^", "2"}], "/", "4"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "'"}], "[", "t0", "]"}], "==", 
          RowBox[{"I", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Beta]", "^", "2"}], "*", 
             RowBox[{"t0", "/", "2"}]}], ")"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", "*", 
             RowBox[{"\[Beta]", "^", "2"}], "*", 
             RowBox[{
              RowBox[{"t0", "^", "2"}], "/", "4"}]}], "]"}]}]}]}], "}"}], ",",
        "v", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
       RowBox[{"MaxSteps", "->", "100000"}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vNum", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"v", "[", "t", "]"}], "/.", " ", "solV"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9920516040429173`*^9, 3.9920516213970633`*^9}, {
   3.99205173540445*^9, 3.992051737428198*^9}, 3.992052093424314*^9},
 CellLabel->
  "In[365]:=",ExpressionUUID->"7fd1e074-aaa1-42c1-8bb2-91fe8dc0adaf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"vNum", "[", "t", "]"}], "-", 
     RowBox[{"vExact", "[", "t", "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "t0", ",", "tf"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", "Purple"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<|v_num - v_exact|\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Error Absoluto de la Integraci\[OAcute]n Num\[EAcute]rica para \
v(t)\>\""}]}], "]"}]], "Input",

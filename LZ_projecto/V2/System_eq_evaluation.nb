Cell[BoxData[
 RowBox[{
  RowBox[{"denominador2", "[", "t_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}], "2"]}], ",", 
      RowBox[{"\[ImaginaryI]", " ", "*", 
       RowBox[{"z", "[", "t", "]"}]}]}], "]"}], " ", 
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}], "2"], ",", 
      RowBox[{"z", "[", "t", "]"}]}], "]"}]}], "+", 
   RowBox[{"\[ImaginaryI]", " ", 
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}], "2"]}], ",", 
      RowBox[{"\[ImaginaryI]", " ", "*", 
       RowBox[{"z", "[", "t", "]"}]}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ParabolicCylinderD", "[", 
       RowBox[{
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}], "2"]}], ",", 
        RowBox[{"z", "[", "t", "]"}]}], "]"}], "-", 
      RowBox[{"z0", " ", 
       RowBox[{"ParabolicCylinderD", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}], "2"], ",", 
         RowBox[{"z", "[", "t", "]"}]}], "]"}]}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.99205111176775*^9, 3.99205117059093*^9}},
 CellLabel->
  "In[342]:=",ExpressionUUID->"6487ed9f-7a47-4ac7-a733-1def0d5d2803"],


Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["L", "TI"], "\[Gamma]"], 
     OverscriptBox["\[Rho]", "~"]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         RowBox[{
          StyleBox["j", "TI"], "\[LongEqual]", "1"}]}], "2",
        LimitsPositioning->True], 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         StyleBox[
          RowBox[{"i", "j"}], "TI"]], "(", 
        RowBox[{
         RowBox[{"2", 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "-"], 
          OverscriptBox["\[Rho]", "~"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["j", "TI"], "+"]}], "-", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "+"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["j", "TI"], "-"], 
          OverscriptBox["\[Rho]", "~"]}], "-", 
         RowBox[{
          OverscriptBox["\[Rho]", "~"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "+"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["j", "TI"], "-"]}]}], ")"}]}]}], "+", 
     RowBox[{
      FractionBox[
       SubscriptBox["\[Gamma]", "\[Sigma]"], "2"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{
         StyleBox["i", "TI"], "=", "3"}], "4",
        LimitsPositioning->True], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "-"], 
          OverscriptBox["\[Rho]", "~"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "+"]}], "-", 
         RowBox[{
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "+"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "-"], 
          OverscriptBox["\[Rho]", "~"]}], "-", 
         RowBox[{
          OverscriptBox["\[Rho]", "~"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "+"], 
          SubsuperscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["i", "TI"], "-"]}]}], ")"}]}]}]}]}],
   FontSize->36,
   FontWeight->"Plain"], TraditionalForm]], "Text",
 CellChangeTimes->{{3.938683314412781*^9, 3.938683316968828*^9}, {
   3.938683410611395*^9, 3.938683413575918*^9}, 
   3.938684315369815*^9},ExpressionUUID->"c504b861-e724-4f22-ac1f-\
fc97fe9eba5e"],

Cell[TextData[{
 StyleBox["With the above master equation the resulting Bloch equations for \
the atomic expectation values can be written  compactly as",
  FontSize->36,
  Background->GrayLevel[0.85]],
 StyleBox["\n",
  FontSize->36,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", 
        StyleBox["t", "TI"]], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["Q",
          FontSlant->"Bold"], "(", 
         StyleBox["t", "TI"], ")"}], "\[RightAngleBracket]"}]}], 
      "\[LongEqual]", 
      RowBox[{
       StyleBox["M",
        FontSlant->"Bold"], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["Q",
          FontSlant->"Bold"], "(", 
         StyleBox["t", "TI"], ")"}], "\[RightAngleBracket]"}]}]}], ","}],
    FontSize->36], TraditionalForm]],
  CellChangeTimes->{{3.938683388990551*^9, 3.938683407771495*^9}, 
    3.93868398665903*^9, 3.93868414262058*^9},
  Background->None,ExpressionUUID->"4338e9d0-2948-4a75-8733-207185c91f24"],
 "\n",
 StyleBox["whose formal solution is given by",
  FontSize->36,
  Background->GrayLevel[0.85]],
 StyleBox["\n",
  FontSize->36,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["Q",
        FontSlant->"Bold"], "(", 
       StyleBox["t", "TI"], ")"}], "\[RightAngleBracket]"}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        StyleBox["M",
         FontSlant->"Bold"], 
        StyleBox["t", "TI"]}]], 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        StyleBox["Q",
         FontSlant->"Bold"], "(", "0", ")"}], "\[RightAngleBracket]"}]}]}],
    FontSize->36,
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.9386841090679903`*^9, 3.938684133104267*^9}},
  Background->None,ExpressionUUID->"1a79889a-8f15-441d-91b8-621c6c5231fb"]
}], "Text",
 CellChangeTimes->{{3.938621752614256*^9, 3.938621758677316*^9}, 
   3.938621911474428*^9, {3.938622307901442*^9, 3.9386223601109247`*^9}, {
   3.93862288370411*^9, 3.938622887637058*^9}, 3.938635418478673*^9, {
   3.9386949257974*^9, 3.938694936745118*^9}, {3.939374155130344*^9, 
   3.939374161948056*^9}},ExpressionUUID->"efc193dd-2c8e-4139-b263-\
d4aa5abd98e6"],

Cell[TextData[{
 StyleBox["Applying the quantum regression formula we get",
  FontSize->36,
  FontColor->GrayLevel[0],
  Background->GrayLevel[0.85]],
 StyleBox["\n",
  FontSize->36,
  FontSlant->"Italic",
  FontColor->GrayLevel[0.5]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Tau]"], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["W",
          FontSlant->"Bold"], "(", 
         RowBox[{
          SubscriptBox[
           StyleBox["t", "TI"], "1"], ",", "\[Tau]"}], ")"}], 
        "\[RightAngleBracket]"}]}], "\[LongEqual]", 
      RowBox[{
       StyleBox["M",
        FontSlant->"Bold"], 
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["W",
          FontSlant->"Bold"], "(", 
         RowBox[{
          SubscriptBox[
           StyleBox["t", "TI"], "1"], ",", "\[Tau]"}], ")"}], 
        "\[RightAngleBracket]"}]}]}], ","}],
    FontSize->36,
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{{3.938683975719203*^9, 3.938683996022331*^9}, 
    3.9386841786700897`*^9, 3.93868421625313*^9},
  Background->None,ExpressionUUID->"9221b493-51ab-4689-ac4a-693994436863"],
 "\n",
 StyleBox["whose formal solution is given by",
  FontSize->36,
  Background->GrayLevel[0.85]],
 StyleBox["\n",
  FontSize->36,
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       StyleBox["W",
        FontSlant->"Bold"], "(", 
       RowBox[{
        SubscriptBox[
         StyleBox["t", "TI"], "1"], ",", "\[Tau]"}], ")"}], 
      "\[RightAngleBracket]"}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       StyleBox["e", "TI"], 
       RowBox[{
        StyleBox["M",
         FontSlant->"Bold"], "\[Tau]"}]], 
      RowBox[{
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         StyleBox["W",
          FontSlant->"Bold"], "(", 
         RowBox[{
          SubscriptBox[
           StyleBox["t", "TI"], "1"], ",", "0"}], ")"}], 
        "\[RightAngleBracket]"}], "."}]}]}],
    FontSize->36,
    FontWeight->"Plain"], TraditionalForm]],
  CellChangeTimes->{3.938684222427139*^9, 3.938684367471929*^9},
  Background->None,ExpressionUUID->"9639612b-c930-4d1c-bfbd-c6b6c33bfb8a"]
}], "Text",

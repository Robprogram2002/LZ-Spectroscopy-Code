Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"MatrixM", "[", 
    RowBox[{"\[Delta]_", ",", "\[CapitalDelta]_", ",", "\[CapitalOmega]_"}], 
    "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", "0", 
       ",", "0", ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", "0", ",", "0", 
       ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]"}]}], ")"}]}], ",", 
       "0", ",", "0", ",", "0", ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", "0", ",", 
       "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", "0", ",", "0", 
       ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "+", 
          RowBox[{"\[ImaginaryI]", 
           RowBox[{"(", 
            RowBox[{"\[CapitalDelta]", "-", "\[Delta]"}], ")"}]}]}], ")"}]}], 
       ",", "0", ",", "0", ",", "0", ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", "0", ",", "0", 
       ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "-", 
          RowBox[{"\[ImaginaryI]", " ", "\[CapitalDelta]"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", "0", 
       ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "3"], ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", 
       FractionBox["2", "3"], ",", "0", ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", "0", 
       ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", "0", 
       ",", "0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "2"], "-", 
          RowBox[{"\[ImaginaryI]", 
           RowBox[{"(", 
            RowBox[{"\[CapitalDelta]", "-", "\[Delta]"}], ")"}]}]}], ")"}]}], 
       ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["2", "3"], ",", "0", ",", 
       FractionBox["1", "3"], ",", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[CapitalOmega]"}], ",", "0", 
       ",", "0", ",", 
       RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]"}], ",", "0"}], "}"}]}],
     "}"}]}],
  FontSize->24]], "Input",
 CellChangeTimes->{{3.817220692784165*^9, 3.817220692923929*^9}, {

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox[
     RowBox[{
      SubscriptBox["\[PartialD]", 
       StyleBox["t", "TI"]], 
      OverscriptBox["\[Rho]", "~"]}],
     FontSize->48], 
    StyleBox["\[LongEqual]",
     FontSize->48], 
    RowBox[{
     RowBox[{
      StyleBox["-",
       FontSize->48], 
      RowBox[{
       StyleBox[
        FractionBox["i", "\[HBar]"],
        FontSize->36], 
       StyleBox["[",
        FontSize->48], 
       StyleBox[
        RowBox[{
         StyleBox["H", "TI"], ",", 
         OverscriptBox["\[Rho]", "~"]}],
        FontSize->48], 
       StyleBox["]",
        FontSize->48]}]}], 
     StyleBox["+",
      FontSize->48], 
     StyleBox[
      RowBox[{
       SubscriptBox[
        StyleBox["L", "TI"], "\[Gamma]"], 
       OverscriptBox["\[Rho]", "~"]}],
      FontSize->48]}]}], 
   StyleBox[",",
    FontSize->48], 
   StyleBox[" ",
    FontSize->48]}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.938621722391227*^9, 3.938621723239575*^9}, {

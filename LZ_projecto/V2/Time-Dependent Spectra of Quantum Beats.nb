   3.938684328655217*^9},ExpressionUUID->"d71dd505-ebbb-4977-9468-\
e4e158bda502"],

Cell[TextData[StyleBox["where",
 FontSize->36,
 Background->GrayLevel[0.85]]], "Text",
 CellChangeTimes->{{3.938621752614256*^9, 3.938621758677316*^9}, 
   3.938621911474428*^9, {3.938622307901442*^9, 3.9386223601109247`*^9}, {

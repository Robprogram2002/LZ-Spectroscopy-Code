Cell[TextData[StyleBox["Matrix analysis of the J = 1/2 to J = 1/2 system (\
\[Pi]  transitions).\[LineSeparator]The master equation in our article is",
 FontSize->36,
 Background->GrayLevel[0.85]]], "Text",
 CellChangeTimes->{{3.938621752614256*^9, 3.938621758677316*^9}, 

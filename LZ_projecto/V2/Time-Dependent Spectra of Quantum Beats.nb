Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"Trace05", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{"SpectrumSE", "[", 
         RowBox[{
         "\[CapitalGamma]", ",", "\[Nu]", ",", "0.5", ",", "1", ",", 
          "\[Delta]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{"-", "10"}], ",", "12", ",", "0.1"}], "}"}]}], "]"}]}], ";"}],
  
  FontSize->24], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"Trace1", "=", " ", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"{", 

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"SpectrumSE", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Nu]_", ",", "t_", ",", "\[Gamma]_", ",", 
     "\[Delta]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"F", "[", 
      RowBox[{
      "\[CapitalGamma]", ",", "\[Nu]", ",", "t", ",", "0", ",", "\[Gamma]"}], 
      "]"}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[CapitalGamma]", "-", "\[Gamma]"}], ")"}], "2"], "+", 
      RowBox[{"4", 
       SuperscriptBox["\[Nu]", "2"]}]}]], "+", 
    FractionBox[
     RowBox[{"F", "[", 
      RowBox[{
      "\[CapitalGamma]", ",", "\[Nu]", ",", "t", ",", "\[Delta]", ",", 
       "\[Gamma]"}], "]"}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[CapitalGamma]", "-", "\[Gamma]"}], ")"}], "2"], "+", 
      RowBox[{"4", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"\[Nu]", "+", "\[Delta]"}], ")"}], "2"]}]}]]}]}],
  FontSize->36], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Nu]_", ",", "t_", ",", "x_", ",", 
     "\[Gamma]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"2", "\[CapitalGamma]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[CapitalGamma]"}], " ", "t"}], "]"}], "+", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Gamma]"}], " ", "t"}], "]"}]}], ")"}]}], "-", 
    RowBox[{"4", "\[CapitalGamma]", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"\[Gamma]", "+", "\[CapitalGamma]"}], ")"}]}], 
       RowBox[{"t", "/", "2"}]}], "]"}], 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Nu]", "+", "x"}], ")"}], "t"}], "]"}]}]}]}],
  FontSize->36]}], "Input",
 CellChangeTimes->{{3.933674369216906*^9, 3.933674405422679*^9}, {
   3.933674944390331*^9, 3.933675051914614*^9}, {3.9336751320673857`*^9, 

Cell[BoxData[
 RowBox[{
  RowBox[{"L1", "[", 
   RowBox[{"\[CapitalGamma]_", ",", "\[Omega]_", ",", "T_", ",", "T0_"}], 
   "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalGamma]", "-", 
           RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"alphaZInterp", "[", "t", "]"}]}], "]"}], 
       RowBox[{"alphaMenosInterp", "[", "t", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", "T0", ",", "T"}], "}"}], ",", " ", 
      RowBox[{"MaxRecursion", "->", "20"}]}], "]"}], "]"}], "^", 
   "2"}]}]], "Input",

     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "\[Omega]", ",", 
        RowBox[{"S", "[", 
         RowBox[{"\[CapitalGamma]", ",", "\[Omega]", ",", "t", ",", "T0"}], 
         "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "\[Omega]", ",", "\[Omega]Min", ",", "\[Omega]Max", ",", "0.025"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tMin", ",", "tMax", ",", "0.5"}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Flatten", " ", "the", " ", "data", " ", "for", " ", "ListDensityPlot"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"flatData", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"data", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Create", " ", "the", " ", "density", " ", "plot"}], "*)"}]}], "\n", 

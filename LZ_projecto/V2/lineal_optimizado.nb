Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SBas", "[", "\[Omega]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[CapitalOmega]", "/", "\[CapitalOmega]r"}], ")"}], "^", 
      "2"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[CapitalGamma]", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["\[CapitalDelta]", "\[CapitalOmega]r"]}], ")"}]}], 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", "^", "2"}], " ", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Omega]", "-", "\[Nu]", "-", "\[CapitalOmega]r"}], 
            ")"}], "^", "2"}]}], ")"}]}]], "+", 

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"alphaMenosInterp", "[", "t", "]"}], "]"}], "^", "2"}], 
       ")"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], 
        RowBox[{"Re", "[", 
         RowBox[{"alphaZInterp", "[", "t", "]"}], "]"}]}], "]"}]}], ",", " ", 
     
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"alphaZInterp", "[", "t", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"alphaZInterp", "[", "t", "]"}]}], "]"}], " ", 
         RowBox[{"alphaMasInterp", "[", "t", "]"}], " ", 
         RowBox[{"alphaMenosInterp", "[", "t", "]"}]}]}], "]"}], "^", "2"}], ",",
      " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[Pi]"}], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[CapitalOmega]", "^", "2"}], 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"\[Beta]", "^", "2"}], ")"}]}]], ")"}]}], "]"}], ",", " ", 
     
     RowBox[{"1", "-", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"\[CapitalOmega]", "^", "2"}], 
          RowBox[{"(", 
           RowBox[{"2", 
            RowBox[{"\[Beta]", "^", "2"}]}], ")"}]], ")"}]}], "]"}]}]}], 
    "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"-", "200"}], ",", " ", "200"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Probabilidades de transici\[OAcute]n  \[Beta] = 0.1 , \
\[CapitalOmega] = 0.4, |\[Psi](0)\[RightAngleBracket] = \
|e\[RightAngleBracket] \>\"", ",", " ", "18", ",", " ", 
      RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}], ",", " ", 
      "Black"}], "]"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thickness", "[", "0.003", "]"}], ",", " ", 
      RowBox[{"Thickness", "[", "0.003", "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Dashed", ",", " ", 
        RowBox[{"Thickness", "[", "0.002", "]"}], ",", " ", "Orange", ",", 
        " ", 
        RowBox[{"Opacity", "[", "0.85", "]"}]}], "]"}], ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Dashed", ",", " ", 
        RowBox[{"Thickness", "[", "0.002", "]"}], ",", " ", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0", ",", "0.45", ",", "0.8"}], "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.85", "]"}]}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(e\\\  \[Rule] g\)]\)(t)\>\"", ",",
       " ", "\"\<\!\(\*SubscriptBox[\(P\), \(e \[Rule] e\)]\)(t)\>\"", ",", 
      " ", "\"\<exp(-\[Pi] \!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(2\)]\) \
/ 2 \!\(\*SuperscriptBox[\(\[Beta]\), \(2\)]\))\>\"", 
      ",", "\"\<1-exp(-\[Pi] \!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(2\)]\
\) / 2 \!\(\*SuperscriptBox[\(\[Beta]\), \(2\)]\))\>\""}], "}"}]}], ",", 
   RowBox[{"FrameTicksStyle", "->", 

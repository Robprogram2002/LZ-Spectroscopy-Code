Cell[CellGroupData[{

Cell["Espectro EW estado base", "Section",
 CellChangeTimes->{{3.945961729840106*^9, 3.945961738527079*^9}, {
  3.946845488861795*^9, 
  3.946845499393071*^9}},ExpressionUUID->"5cf2688e-c293-40cd-b91f-\
789931124816"],

Cell[BoxData[
 RowBox[{
  RowBox[{"I1", "[", 
   RowBox[{
   "\[CapitalGamma]_", ",", " ", "\[Omega]_", ",", " ", "T_", ",", " ", 
    "T0_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalGamma]", "-", 
            RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}]}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], 
       RowBox[{
        RowBox[{"alphaMenos", "[", "t", "]"}], "^", "2"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", "T0", " ", ",", " ", "T"}], "}"}], ",", " ", 
      RowBox[{"MaxRecursion", "->", "20"}]}], "]"}], "]"}], "^", 
   "2"}]}]], "Input",

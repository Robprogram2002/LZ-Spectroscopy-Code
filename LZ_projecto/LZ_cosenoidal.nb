Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"alphaMas", ",", " ", "alphaZ", ",", " ", "alphaMenos"}], "}"}], "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "-", "  ", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], " ", "+", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"I", " ", "\[CapitalOmega]"}], "2"], 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}]}]}], "==", " ", 
       "0"}], " ", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{
        FractionBox["I", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Beta]", " ", "t"}], "]"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], "]"}]}], "+", " ", 
        FractionBox[
         RowBox[{"I", " ", "\[CapitalOmega]"}], "2"]}], " ", "==", " ", "0"}],
       ",", " ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"-", "150"}], "]"}], "==", 
       RowBox[{"y", "[", 
        RowBox[{"-", "150"}], "]"}], "==", 
       RowBox[{"z", "[", 
        RowBox[{"-", "150"}], "]"}], "==", " ", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", " ", "z"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"-", "250"}], ",", " ", "250"}], "}"}], ",", 
    RowBox[{"AccuracyGoal", "->", "10"}], ",", " ", 
    RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9472769425730963`*^9, 3.947277059364317*^9}, {
  3.947501792806456*^9, 3.947501811052003*^9}, {3.949134218791814*^9, 
  3.949134235872283*^9}, {3.957667986440708*^9, 3.957668011456819*^9}},

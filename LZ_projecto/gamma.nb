Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"alphaMas", ",", " ", "alphaZ", ",", " ", "alphaMenos"}], "}"}], "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "-", "  ", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], " ", "+", " ", 
        RowBox[{"I", " ", "\[CapitalOmega]", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}]}]}], "==", " ", 
       "0"}], " ", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{"I", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", "^", "2"}], " ", ")"}], "t"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], "]"}]}], "+", " ", 
        RowBox[{"I", " ", "\[CapitalOmega]"}]}], " ", "==", " ", "0"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"-", "150"}], "]"}], "==", 
       RowBox[{"y", "[", 
        RowBox[{"-", "150"}], "]"}], "==", 
       RowBox[{"z", "[", 
        RowBox[{"-", "150"}], "]"}], "==", " ", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", " ", "z"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"-", "250"}], ",", " ", "250"}], "}"}], ",", 
    RowBox[{"AccuracyGoal", "->", "10"}], ",", " ", 
    RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}]], "Input",

Cell["Ecuaci\[OAcute]n diferencial para \[Alpha]_z", "Text",
 CellChangeTimes->{{3.94588878689104*^9, 
  3.9458887975029297`*^9}},ExpressionUUID->"5697a98a-47ed-4c8c-80f0-\
3f8c842ad9ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"alphaZ", "[", "T_", "]"}], " ", ":=", " ", 
  RowBox[{"I", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", " ", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"alphaMas", "[", "t", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", " ", ",", " ", "T"}], "}"}]}], "]"}]}], 
     " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Beta]", "^", " ", "2"}], ")"}], 
      RowBox[{"(", " ", 
       RowBox[{"T", "^", "2"}], ")"}], 
      RowBox[{"(", " ", "0.5", ")"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9457689375439463`*^9, 3.945768989544574*^9}, {
   3.9457690765862923`*^9, 3.945769083971539*^9}, {3.945769120769375*^9, 

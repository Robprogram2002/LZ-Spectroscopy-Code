  RowBox[{"\[Beta]", " ", "=", " ", "0.3"}], ";", " ", 
  RowBox[{"\[CapitalOmega]", " ", "=", " ", "0.2"}], ";"}]], "Input",
 CellLabel->
  "In[184]:=",ExpressionUUID->"57f85eeb-4da1-4b7e-9a18-b6ee1092cff8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"alphas", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "-", "  ", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], " ", "+", " ", 
        RowBox[{"I", " ", "\[CapitalOmega]", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}]}]}], "==", " ", 
       "0"}], " ", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{"I", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", "^", "2"}], " ", ")"}], "t"}]}], ")"}]}]}], 
      ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], "]"}]}], "+", " ", 
        RowBox[{"I", " ", "\[CapitalOmega]"}]}], " ", "==", " ", "0"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"-", "100"}], "]"}], "==", 
       RowBox[{"y", "[", 
        RowBox[{"-", "100"}], "]"}], "==", 
       RowBox[{"z", "[", 
        RowBox[{"-", "100"}], "]"}], "==", " ", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", " ", "z"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"-", "110"}], ",", " ", "110"}], "}"}], ",", " ", 
    RowBox[{"PrecisionGoal", "->", "15"}]}], "]"}]}]], "Input",
 CellChangeTimes->{3.9466555377727337`*^9},
 CellLabel->
  "In[185]:=",ExpressionUUID->"f2c16906-2010-46a8-b532-bd651f28caea"],


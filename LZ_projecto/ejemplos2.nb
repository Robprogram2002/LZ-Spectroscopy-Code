Cell["Ecuaci\[OAcute]n diferencial para \[Alpha]_-", "Text",
 CellChangeTimes->{{3.945888869234798*^9, 
  3.94588888188758*^9}},ExpressionUUID->"68a11731-74c6-482b-8b48-\
f6fba68348ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"alphaMenos", "[", "T_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"-", "I"}], " ", "\[CapitalOmega]", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"2", " ", 
       RowBox[{"alphaZInter", "[", "t", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "1", ",", " ", "T"}], "}"}]}], 
    "]"}]}]}]], "Input",

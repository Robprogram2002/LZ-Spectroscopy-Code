Cell["\<\
Probabilidad de transici\[OAcute]n al estado excitado considerando que el \
estado inicial es el estado excitado (P_e->e(t))\
\>", "Text",
 CellChangeTimes->{{3.945877964874913*^9, 
  3.945877992998794*^9}},ExpressionUUID->"eb33b404-69d0-4d6d-98f6-\
262844f06c6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"alphaZ", "[", "t", "]"}], "]"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
       RowBox[{"alphaMas", "[", "t", "]"}], " ", 
       RowBox[{"alphaMenos", "[", "t", "]"}]}]}], "]"}], "^", "2"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"-", "60"}], ",", " ", "60"}], "}"}]}], "]"}]], "Input",

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"alphaMenos", "[", "t", "]"}], "]"}], "^", "2"}], ")"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], 
        RowBox[{"Re", "[", 
         RowBox[{"alphaZ", "[", "t", "]"}], "]"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"alphaZ", "[", "t", "]"}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"alphaZ", "[", "t", "]"}]}], "]"}], " ", 
         RowBox[{"alphaMas", "[", "t", "]"}], " ", 
         RowBox[{"alphaMenos", "[", "t", "]"}]}]}], "]"}], "^", "2"}], ",", 
     " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[Pi]"}], 
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[CapitalOmega]", "^", "2"}], 
         RowBox[{"\[Beta]", "^", "2"}]], ")"}]}], "]"}], ",", " ", 
     RowBox[{"1", "-", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "\[Pi]"}], 
        RowBox[{"(", 
         FractionBox[
          RowBox[{"\[CapitalOmega]", "^", "2"}], 
          RowBox[{"\[Beta]", "^", "2"}]], ")"}]}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", 
     RowBox[{"-", "30"}], ",", " ", "60"}], "}"}], ",", "\[IndentingNewLine]",
    " ", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Probabilidades de transici\[OAcute]n  \[Beta] = 0.2 , \
\[CapitalOmega] = 0.004, |\[Psi] (0) \[RightAngleBracket] = |e\
\[RightAngleBracket] \>\"", ",", " ", "16", ",", " ", 
      RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}], ",", " ", 
      "Black"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(e -> g\)]\)(t)\>\"", ",", 
      " ", "\"\<\!\(\*SubscriptBox[\(P\), \(e -> e\)]\)(t)\>\"", ",", 
      " ", "\"\<exp(-\[Pi] \!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(2\)]\) \
/ \!\(\*SuperscriptBox[\(\[Beta]\), \(2\)]\))\>\"", 
      ",", "\"\<1-exp(-\[Pi] \!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(2\)]\
\) / \!\(\*SuperscriptBox[\(\[Beta]\), \(2\)]\))\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotLabels", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<0.998744\>\"", ",", " ", "14", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}], ",", 
        RowBox[{"GrayLevel", "[", "0.26", "]"}]}], "]"}]}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<t\>\"", ",", "16", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}], ",", 
        RowBox[{"GrayLevel", "[", "0.26", "]"}]}], "]"}], " ", ",", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(e\)]\)(t)\>\"", ",", "16", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}], ",", 
        RowBox[{"GrayLevel", "[", "0.26", "]"}]}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"FrameTicksStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"20", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"20", ",", "20"}], "}"}]}], "}"}]}], ",", 

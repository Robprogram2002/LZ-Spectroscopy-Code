Cell["Caso desacoplado Comparaci\[OAcute]n", "Section",
 CellChangeTimes->{{3.9491327128056993`*^9, 
  3.949132723477744*^9}},ExpressionUUID->"537ec1d8-c2d2-4068-b4cc-\
3acea67d64cc"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"NumEW2Tanh", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Beta]_", ",", "\[CapitalDelta]_", ",", "to_", 
     ",", "T_"}], "]"}], ":=", 
   RowBox[{"2", "\[CapitalGamma]", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", "T"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalGamma]", " ", "-", 
              RowBox[{"I", " ", "\[CapitalDelta]"}]}], " ", ")"}], "t"}], "+", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"4", "/", "\[Beta]"}], ")"}], " ", 
            RowBox[{"Log", "[", 
             RowBox[{"Cosh", "[", " ", 
              RowBox[{"\[Beta]", " ", 
               RowBox[{"t", "/", "2"}]}], "]"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "to", ",", "T"}], "}"}]}], "]"}], "]"}], "^", 
      "2"}], ")"}]}]}],
  FontSize->24]], "Input",
 CellChangeTimes->{{3.95027983970232*^9, 3.950279936039695*^9}, {
  3.9502820842620792`*^9, 3.950282084402169*^9}, {3.9503572898520937`*^9, 
  3.950357313288807*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"3c097f5c-27d5-4060-b45a-963e9dede0f0"],


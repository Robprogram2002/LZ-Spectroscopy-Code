Cell["\<\
Expresi\[OAcute]n analitica para el espectro fisico en el caso \
\[CapitalOmega] = 0.\
\>", "Text",
 CellChangeTimes->{{3.943036478336602*^9, 
  3.9430365112995167`*^9}},ExpressionUUID->"c14c6e90-8312-418f-8962-\
5de07f8f8c23"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"EWLinear", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Beta]_", ",", "\[Omega]_", ",", "T_"}], "]"}],
    ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Pi]", " ", "\[CapitalGamma]"}], 
     RowBox[{"2", " ", 
      SuperscriptBox["\[Beta]", "2"]}]], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", 
      RowBox[{"(", 
       RowBox[{"T", "-", 
        RowBox[{"\[Omega]", " ", "/", 
         RowBox[{"(", 
          RowBox[{"2", 
           RowBox[{"\[Beta]", "^", "2"}]}], ")"}]}]}], ")"}]}], "]"}], 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Erfc", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"I", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}], ")"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[CapitalGamma]", "-", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"\[Omega]", "-", 
              RowBox[{"2", "T", " ", 
               RowBox[{"\[Beta]", "^", "2"}]}]}], ")"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "\[Beta]"}], ")"}]}]}], "]"}], "]"}], "^", "2"}]}]}],
  FontSize->24]], "Input",
 CellChangeTimes->{{3.929646241547119*^9, 3.929646273582596*^9}, {
  3.929646404757743*^9, 3.929646439058923*^9}, {3.929646506274302*^9, 
  3.929646541028212*^9}, {3.943036521011949*^9, 3.943036529300417*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"18098b4e-2e01-43be-88e5-9762a05017e6"],


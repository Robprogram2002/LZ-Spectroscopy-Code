          RowBox[{"NumEW2Tanh", "[", 
           RowBox[{"0.05", ",", 
            RowBox[{
             RowBox[{"(", "0.5", ")"}], "^", "2"}], ",", "\[CapitalDelta]", 
            ",", 
            RowBox[{"-", "200"}], ",", 
            StyleBox[
             RowBox[{"7", "0"}]]}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"-", "2"}], ",", "2", ",", "0.01"}], "}"}]}], "]"}], ",", 

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"NumEW3Periodic", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Nu]_", ",", "\[CapitalDelta]_", ",", "to_", ",",
      "T_"}], "]"}], ":=", 
   RowBox[{"2", "\[CapitalGamma]", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", "T"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalGamma]", " ", "-", 
              RowBox[{"I", " ", "\[CapitalDelta]"}]}], " ", ")"}], "t"}], "+", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"1", "/", "\[Nu]"}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Nu]", " ", "t"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "to", ",", "T"}], "}"}]}], "]"}], "]"}], "^", 
      "2"}], ")"}]}]}],
  FontSize->24]], "Input",

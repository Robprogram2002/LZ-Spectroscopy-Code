Cell[CellGroupData[{

Cell["Mollow", "Section",
 CellChangeTimes->{{3.9484905244940157`*^9, 
  3.948490525355595*^9}},ExpressionUUID->"a57bc7f5-af74-40b8-bae5-\
5c1ffa47f4ae"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]", ">", "0"}], "&&", 
     RowBox[{"\[CapitalGamma]", ">", "0"}]}], ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CapitalGamma]", "-", 
          RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"\[CapitalOmega]", " ", 
         RowBox[{"t", " ", "/", " ", "2"}]}], "]"}], "^", "2"}]}], "]"}]}], 
   "]"}],
  FontSize->24]], "Input",
 CellChangeTimes->{{3.9484432454162693`*^9, 3.9484433854167233`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"cbb06316-00ae-4eee-beb2-ed70491589cd"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"t", " ", 
    RowBox[{"(", 
     RowBox[{"\[CapitalGamma]", "-", 
      RowBox[{"\[ImaginaryI]", " ", "\[Omega]"}]}], ")"}]}]], " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", 
    FractionBox[
     RowBox[{"t", " ", "\[CapitalOmega]"}], "2"], "]"}], "2"]}]], "Output",
 CellChangeTimes->{3.948443386279084*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"2bd42844-4aeb-4b04-85d6-23fbb9efbb5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{"l1", " ", "=", " ", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Omega]", "\[Element]", "Reals"}], " ", "&&", 
      RowBox[{"\[CapitalGamma]", "\[Element]", "Reals"}], "&&", 
      RowBox[{"\[CapitalGamma]", ">", "0"}]}], ",", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalGamma]", "-", 
            RowBox[{"I", " ", "\[Omega]"}]}], ")"}], "t"}], "]"}], 
        RowBox[{
         RowBox[{"Sin", "[", 

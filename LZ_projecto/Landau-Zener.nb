Cell[BoxData[
 RowBox[{
  RowBox[{"MollowNumeric", "[", 
   RowBox[{
   "\[Omega]_", ",", " ", "\[CapitalGamma]_", ",", "\[Lambda]_", ",", " ", 
    "\[CapitalOmega]_", ",", " ", "T_"}], "]"}], ":=", 
  RowBox[{"2", "\[CapitalGamma]", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", "T"}], "]"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalGamma]", "-", 
              RowBox[{"I", " ", 
               RowBox[{"(", 
                RowBox[{"\[Omega]", "-", "\[Lambda]"}], ")"}]}]}], ")"}], 
            "t"}], "]"}], 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[CapitalOmega]", " ", 
             RowBox[{"t", " ", "/", " ", "2"}]}], "]"}], "^", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}], "]"}], "^", 
      "2"}], "+", " ", 
     RowBox[{
      FractionBox["1", "4"], 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[CapitalGamma]", "-", 
               RowBox[{"I", " ", 
                RowBox[{"(", 
                 RowBox[{"\[Omega]", "-", "\[Lambda]"}], ")"}]}]}], ")"}], 
             "t"}], "]"}], 
           RowBox[{"Sin", "[", 
            RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "T"}], "}"}]}], "]"}], "]"}], "^", 
       "2"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.948446489109358*^9, 3.948446536051313*^9}, {

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"xsol", ",", "ysol"}], "}"}], "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"y", "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], "^", "2"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"x", "[", "t", "]"}]}], "-", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "^", "3"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", 
       RowBox[{"y", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "20"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.943027832993493*^9, 3.943027832994336*^9}},
 CellLabel->
  "In[453]:=",ExpressionUUID->"620d94c7-3fec-442c-9809-4e2a5e88c31d"],


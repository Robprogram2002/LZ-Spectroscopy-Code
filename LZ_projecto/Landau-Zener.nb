Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
      RowBox[{"y", "[", "x", "]"}]}], "==", "x"}], ",", 
    RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9430277905485563`*^9, 3.943027790549597*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"a71b24a8-fd98-4366-b75b-d8f76236bce3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "1"}], "+", "x", "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "x"}]], " ", 
   TemplateBox[{"1"},
    "C"]}]}]], "Output",
 CellChangeTimes->{3.943027792003701*^9},
 CellLabel->
  "Out[174]=",ExpressionUUID->"95f18552-1602-4a4c-97bb-85ee76b2a3f6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolveValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
       RowBox[{"y", "[", "x", "]"}]}], "==", "x"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", 
      RowBox[{"-", "1"}]}]}], "}"}], ",", 
   RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.943027845325571*^9, 3.94302784532644*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"f4c8e8af-1996-469a-84d3-eedf327edfa4"],

Cell[BoxData[

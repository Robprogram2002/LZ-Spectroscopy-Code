Cell["\<\
Por el contrario, podemos usar una soluci\[OAcute]n n\[UAcute]merica para la \
expresi\[OAcute]n del espectro EW \
\>", "Text",
 CellChangeTimes->{{3.9430827763605223`*^9, 
  3.943082808424705*^9}},ExpressionUUID->"5be25884-7822-4370-8dc0-\
72b9bc5b4b18"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"NumEW2Tanh", "[", 
    RowBox[{
    "\[CapitalGamma]_", ",", "\[Beta]_", ",", "\[CapitalDelta]_", ",", "to_", 
     ",", "T_"}], "]"}], ":=", 
   RowBox[{"2", "\[CapitalGamma]", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[CapitalGamma]", " ", "T"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalGamma]", " ", "-", 
              RowBox[{"I", " ", "\[CapitalDelta]"}]}], " ", ")"}], "t"}], "+", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{"2", "/", "\[Beta]"}], ")"}], " ", 
            RowBox[{"Log", "[", 
             RowBox[{"Cosh", "[", 
              RowBox[{"\[Beta]", " ", 
               RowBox[{"t", "/", "2"}]}], "]"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "to", ",", "T"}], "}"}]}], "]"}], "]"}], "^", 
      "2"}], ")"}]}]}],
  FontSize->24]], "Input",
 CellChangeTimes->{{3.917309221005093*^9, 3.917309233867952*^9}, {
   3.917309286706503*^9, 3.917309342633474*^9}, {3.917309375707412*^9, 
   3.917309388117955*^9}, {3.9173094874477873`*^9, 3.917309535955993*^9}, {
   3.917309864911504*^9, 3.917309914166549*^9}, {3.917310123793795*^9, 
   3.917310211782049*^9}, {3.9173106266336803`*^9, 3.9173107224082003`*^9}, {

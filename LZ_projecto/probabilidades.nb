Cell[CellGroupData[{

Cell["Hiperbolico", "Subsubsection",
 CellChangeTimes->{{3.949719715927038*^9, 
  3.949719727734277*^9}},ExpressionUUID->"9136a0ad-8bc9-4528-80df-\
316d90be9ce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"alphaMas", ",", " ", "alphaZ", ",", " ", "alphaMenos"}], "}"}], "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "-", "  ", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}], " ", "+", " ", 
        RowBox[{"I", " ", "\[CapitalOmega]", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "^", "2"}]}], ")"}]}]}], "==", " ", 
       "0"}], " ", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{"I", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", " ", 
           RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
          RowBox[{"Tanh", "[", 
           FractionBox[
            RowBox[{"\[Beta]", " ", "t"}], "2"], "]"}]}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}], 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"y", "[", "t", "]"}]}], "]"}]}], "+", " ", 
        RowBox[{"I", " ", "\[CapitalOmega]"}]}], " ", "==", " ", "0"}], ",", 
      " ", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"-", "150"}], "]"}], "==", 
       RowBox[{"y", "[", 
        RowBox[{"-", "150"}], "]"}], "==", 
       RowBox[{"z", "[", 
        RowBox[{"-", "150"}], "]"}], "==", " ", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", " ", "z"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", 
      RowBox[{"-", "250"}], ",", " ", "250"}], "}"}], ",", 
    RowBox[{"AccuracyGoal", "->", "10"}], ",", " ", 
    RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.946669580823842*^9, 3.94666958508702*^9}, {
   3.9466793158701153`*^9, 3.946679355837532*^9}, {3.9466794002724543`*^9, 
